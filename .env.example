PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/postcard?retryWrites=true&w=majority
MONGODB_DB_NAME=postcard
VERTEX_PROJECT_ID=your_gcp_project_id
VERTEX_IMAGE_MODEL=your_image_model
VERTEX_LOCATION=your_vertex_location
GEMINI_MODEL=gemini-2.0-flash
# Used for Gemini text generation.
GEMINI_API_KEY=your_gemini_api_key
# Used for sending postcard emails through Resend.
RESEND_API_KEY=your_resend_api_key
# Authenticate with ADC before running locally:
# gcloud auth application-default login
# Or set GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
